NODE_ENV=development
PORT=3001

WIKI_URL=https://wiki.grupoultralinknet.com.br
WIKI_API_TOKEN=
WIKI_LOCALE=pt-br
WIKI_TIMEOUT_MS=10000
SEARCH_MAX_RESULTS=20

# Desenvolvimento local com MCP Inspector. Produção exige MCP_AUTH_MODE=oauth.
MCP_AUTH_MODE=api-key
MCP_API_KEY=
MCP_BASE_URL=http://localhost:3001

# OAuth 2.1 (Resource Server). Preencha em produção com seu IdP corporativo.
OAUTH_ISSUER_URL=
OAUTH_JWKS_URL=
OAUTH_RESOURCE_URL=
# Se omitido, usa OAUTH_RESOURCE_URL como audience esperada.
OAUTH_AUDIENCE=
OAUTH_REQUIRED_SCOPES=wiki.read
OAUTH_ALLOWED_ALGORITHMS=RS256
OAUTH_CLOCK_TOLERANCE_SECONDS=5
OAUTH_RESOURCE_DOCUMENTATION_URL=

LOG_LEVEL=info
MAX_PAGE_CONTENT_BYTES=2000000
